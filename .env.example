# =============================================================
# OWNER ADMIN PANEL — ENVIRONMENT TEMPLATE
# Copy to `.env` and fill with REAL values. NEVER commit `.env`.
# =============================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Public URL of this API (used in CORS + cookie settings)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://owneradmin:CHANGE_ME@localhost:5432/owneradmin?schema=public

# ---------- Auth / JWT ----------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Pepper mixed into every password hash (extra layer on top of scrypt)
PASSWORD_PEPPER=CHANGE_ME_password_pepper

# ---------- License signing (ASYMMETRIC) ----------
# Generate a keypair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out keys/license-private.pem
#   openssl rsa -pubout -in keys/license-private.pem -out keys/license-public.pem
# Paths are resolved relative to the backend process working directory.
# The PRIVATE key must live ONLY on the server — never in the frontend, never in git.
LICENSE_PRIVATE_KEY_PATH=keys/license-private.pem
LICENSE_PUBLIC_KEY_PATH=keys/license-public.pem
# Format of the generated license keys, e.g. PROD-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY_PREFIX=PROD
LICENSE_KEY_GROUPS=4
LICENSE_KEY_GROUP_LEN=4

# ---------- Seed (first SUPER_ADMIN) ----------
SEED_ADMIN_EMAIL=owner@company.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ADMIN_NAME=Software Owner

# ---------- Default business settings (seeded into `settings` table) ----------
DEFAULT_CURRENCY=EGP
DEFAULT_VALIDATION_INTERVAL_HOURS=72
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_TRIAL_DAYS=14
DEFAULT_MAX_DEVICES=1
DEFAULT_TIMEZONE=Africa/Cairo
