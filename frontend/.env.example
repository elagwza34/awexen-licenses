# Frontend build-time configuration.
# Only VITE_* variables reach the browser bundle. Never put a secret here.

# In development the Vite dev server proxies /api to the backend, so a relative
# path keeps the browser same-origin and lets the refresh cookie work.
VITE_API_BASE_URL=/api/v1

# Only needed if the API is NOT proxied (e.g. a remote staging host):
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1
