# Security headers applied by Cloudflare Pages.
# The API sets its own headers; these cover the static panel only.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # The panel loads no third-party scripts and talks only to its own API, so a
  # strict policy is safe. 'unsafe-inline' covers Vite's injected styles.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.awexen.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Vite emits content-hashed file names, so these can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML must never be cached, or a deploy would keep serving the old
# bundle names.
/index.html
  Cache-Control: no-cache, must-revalidate
