# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Prisma
backend/prisma/*.db
backend/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Keys — the license signing private key must NEVER be committed
keys/
*.pem
*.key
*.p12
*.pfx

# Test / coverage
coverage/
.nyc_output/

# ---- Local development database (portable PostgreSQL) ----
# Binaries, the data cluster and logs must never enter the repository.
tools/pgsql/
tools/pgdata/
tools/.pgdata/
tools/*.zip
tools/*.log
tools/*.err
backend/api.log
backend/api.err
run.txt
e2e-out.txt

# ---- Local development database (portable PostgreSQL) ----
# Binaries, the data cluster and logs must never enter the repository.
tools/pgsql/
tools/pgdata/
tools/.pgdata/
tools/*.zip
tools/*.log
tools/*.err
backend/api.log
backend/api.err
run.txt
e2e-out.txt

# Vite dev-server noise (was accidentally tracked)
frontend/web.log
frontend/web.err


# Production credentials (Neon URLs). The .txt variants are covered too:
# Notepad appends .txt unless you untick 'Save as type'.
.env*.local
.env*.local.txt
*.local.txt


# Generated by tools/prepare-neon.ps1 - holds the pepper and the bootstrap
# admin password. Must never be committed.
.deploy-secrets.local


# Local diagnostics. These are throwaway load/capacity probes that talk to a
# running dev instance and read its database — no value in shipping them, and
# probe-load.js would otherwise be mistaken for a test suite.
backend/probe-*.js
backend/cleanup-probe-data.js

# Uploaded bank-transfer receipts. These are customers' personal financial
# documents, so they must never be committed; the directory is created on
# first upload.
backend/storage/
storage/
.hostinger/api-source/
